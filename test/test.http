#### Test Jammer On
POST http://192.168.10.11/jammer
Content-Type: application/json

{
    "jamm_freq": 5800,
    "is_on": true
}

#### Test Jammer On
POST http://192.168.10.11/jammer
Content-Type: application/json

{
    "jamm_freq": 2400,
    "is_on": false
}

#### Test Multi Jammer On
POST http://192.168.10.11/jammers
Content-Type: application/json

{
    "jamm_900": true,
    "jamm_1500": true,
    "jamm_2400": true,
    "jamm_5200": true,
    "jamm_5800": true
}

#### Test Multi Jammer Off
POST http://192.168.10.11/jammers
Content-Type: application/json

{
    "jamm_900": false,
    "jamm_1500": false,
    "jamm_2400": false,
    "jamm_5200": false,
    "jamm_5800": false
}

#### Test Fan On
POST http://192.168.10.11/fan
Content-Type: application/json

{
    "is_on": false
}

#### Set RGB notification
POST http://192.168.10.11/notifRGB
Content-Type: application/json

{
    "is_on": true,
    "r": 200,
    "g": 0,
    "b": 0,
    "numb": 0
}

#### Set RGB notification
POST http://192.168.10.11/notifRGB
Content-Type: application/json

{
    "is_on": false,
    "r": 200,
    "g": 0,
    "b": 0,
    "numb": 0
}

#### Set RGB animation
POST http://192.168.10.11/animateRGB
Content-Type: application/json

{
    "is_on": true
}

#### Get Temperature
GET http://192.168.10.11/temp

#### Get Jammer Status
GET http://192.168.10.11/jamm_state

#### Jammer Pulse - Turn on selected, auto turn off all in 20 seconds
POST http://192.168.10.11/jammer/pulse
Content-Type: application/json

{
    "jamm_900": false,
    "jamm_1500": true,
    "jamm_2400": false,
    "jamm_5200": true,
    "jamm_5800": false
}
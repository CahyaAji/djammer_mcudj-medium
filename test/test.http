@Host = http://192.168.17.150:8018

#### Get firmware version, board and serial number
GET {{Host}}/version

#### Jammer on
POST {{Host}}/jammer
Content-Type: application/json

{
    "jamm_freq": 5200,
    "is_on": true
}

#### Jammer off
POST {{Host}}/jammer
Content-Type: application/json

{
    "jamm_freq": 5200,
    "is_on": false
}


#### Multi jammer on
POST {{Host}}/jammers
Content-Type: application/json

{
    "jamm_900": false,
    "jamm_1500": true,
    "jamm_2400": true,
    "jamm_5200": true,
    "jamm_5800": true
}

#### All jammer off
POST {{Host}}/jammers
Content-Type: application/json

{
    "jamm_900": false, 
    "jamm_1500": false,
    "jamm_2400": false,
    "jamm_5200": false,
    "jamm_5800": false
}


#### Get fan mode and state
GET {{Host}}/fan


#### Switch to auto mode
POST {{Host}}/fan/mode
Content-Type: application/json

{
    "mode": "auto"
}

#### Switch to manual mode
POST {{Host}}/fan/mode
Content-Type: application/json

{
    "mode": "manual"
}


#### Fan on (manual mode only)
POST {{Host}}/fan
Content-Type: application/json

{
    "is_on": true
}

#### Fan off (manual mode only, allowed even while a jammer is on)
POST {{Host}}/fan
Content-Type: application/json

{
    "is_on": false
}

#### Get Temperature
GET {{Host}}/temp

#### Get Jammer Status
GET {{Host}}/jamm_state
@Host = http://192.168.17.150:8018

#### Get firmware version, board and serial number
GET {{Host}}/version

#### Jammer on (turns the fan on in auto mode)
POST {{Host}}/jammer
Content-Type: application/json

{
    "jamm_freq": 900,
    "is_on": true
}

#### Jammer off (auto mode then uses the temperatures)
POST {{Host}}/jammer
Content-Type: application/json

{
    "jamm_freq": 900,
    "is_on": false
}

#### Multi jammer on (any true value turns the fan on in auto mode)
POST {{Host}}/jammers
Content-Type: application/json

{
    "jamm_900": false,
    "jamm_1500": true,
    "jamm_2400": true,
    "jamm_5200": true,
    "jamm_5800": true
}

#### Test Multi Jammer Off
POST {{Host}}/jammers
Content-Type: application/json

{
    "jamm_900": false,
    "jamm_1500": false,
    "jamm_2400": false,
    "jamm_5200": false,
    "jamm_5800": false
}

#### Get fan mode and state
GET {{Host}}/fan

#### Switch to manual mode
POST {{Host}}/fan/mode
Content-Type: application/json

{
    "mode": "manual"
}

#### Fan on (manual mode only)
POST {{Host}}/fan
Content-Type: application/json

{
    "is_on": true
}

#### Fan off (manual mode only, allowed even while a jammer is on)
POST {{Host}}/fan
Content-Type: application/json

{
    "is_on": false
}

#### Switch to auto mode
POST {{Host}}/fan/mode
Content-Type: application/json

{
    "mode": "auto"
}

#### Set RGB notification
POST {{Host}}/notifRGB
Content-Type: application/json

{
    "is_on": true,
    "r": 0,
    "g": 200,
    "b": 0,
    "numb": 0
}

#### Set RGB notification
POST {{Host}}/notifRGB
Content-Type: application/json

{
    "is_on": true,
    "r": 200,
    "g": 0,
    "b": 0,
    "numb": 0
}

#### Set RGB animation
# POST {{Host}}/animateRGB
# Content-Type: application/json

# {
#     "is_on": false
# }

#### Get Temperature
GET {{Host}}/temp

#### Get Jammer Status
GET {{Host}}/jamm_state
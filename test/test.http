@Host = http://192.168.17.150:8018

#### Get firmware version
GET {{Host}}/version

#### Jammer on (also turns the fan on, including repeated requests)
POST {{Host}}/jammer
Content-Type: application/json

{
    "jamm_freq": 900,
    "is_on": true
}

#### Jammer off (does not turn the fan off)
POST {{Host}}/jammer
Content-Type: application/json

{
    "jamm_freq": 900,
    "is_on": false
}

#### Multi jammer on (any true value turns the fan on)
POST {{Host}}/jammers
Content-Type: application/json

{
    "jamm_900": true,
    "jamm_1500": true,
    "jamm_2400": true,
    "jamm_5200": true,
    "jamm_5800": true
}

#### Test Multi Jammer Off
POST {{Host}}/jammers
Content-Type: application/json

{
    "jamm_900": false,
    "jamm_1500": false,
    "jamm_2400": false,
    "jamm_5200": false,
    "jamm_5800": false
}

#### Fan on
POST {{Host}}/fan
Content-Type: application/json

{
    "is_on": true
}

#### Fan off (allowed even while a jammer is on)
POST {{Host}}/fan
Content-Type: application/json

{
    "is_on": false
}

#### Set RGB notification
POST {{Host}}/notifRGB
Content-Type: application/json

{
    "is_on": true,
    "r": 0,
    "g": 200,
    "b": 0,
    "numb": 0
}

#### Set RGB notification
POST {{Host}}/notifRGB
Content-Type: application/json

{
    "is_on": true,
    "r": 200,
    "g": 0,
    "b": 0,
    "numb": 0
}

#### Set RGB animation
# POST {{Host}}/animateRGB
# Content-Type: application/json

# {
#     "is_on": false
# }

#### Get Temperature
GET {{Host}}/temp

#### Get Jammer Status
GET {{Host}}/jamm_state